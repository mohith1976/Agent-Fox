# Redis Configuration (LangGraph Checkpointing & Thread Locking)
REDIS_URL="redis://localhost:6380"
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD=""
REDIS_DB="0"


REDIS_TTL_MINUTES="60"

# Thread Lock Configuration
# Lock TTL in SECONDS (prevents stale locks)
# Default: 600 seconds (10 minutes)
LOCK_TTL_SECONDS="600"

# Lock Renewal Configuration
# How often to renew locks in SECONDS (prevents ownership loss)
# Default: 120 seconds (2 minutes)
# Should be significantly less than LOCK_TTL_SECONDS
LOCK_RENEW_INTERVAL_SECONDS="120"
